# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Meltea's mlx views with messages, compiled to templates"
description:
  "meltea-ppx compiles Meltea's mlx views to melhole templates, reads update and view for the model fields each message changes, and can write a view's HTML natively for server rendering."
maintainer: ["Gleb <jongleber@gmail.com>"]
authors: ["Gleb <jongleber@gmail.com>"]
license: "MIT"
homepage: "https://jongleb.github.io/melact-meltea-sites/melact/"
doc: "https://github.com/jongleb/melact#readme"
bug-reports: "https://github.com/jongleb/melact/issues"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.16" & >= "3.16"}
  "ppxlib" {>= "0.39.0"}
  "melhole" {= version}
  "qcheck-core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jongleb/melact.git"
