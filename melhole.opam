# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Templates with holes for Melange: the runtime and the compiler shared by Meltea and Melact"
description:
  "melhole turns a view known at build time into a DOM template with holes and per-template update code, guarded by === on the values each hole reads. It is the runtime and the compiler under Meltea and Melact, and has a server writer that renders the same views to HTML natively."
maintainer: ["Gleb"]
authors: ["Gleb"]
license: "MIT"
homepage: "https://github.com/jongleb/meltea"
bug-reports: "https://github.com/jongleb/meltea/issues"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.16" & >= "3.16"}
  "melange" {>= "7.0.0"}
  "ppxlib" {>= "0.39.0"}
  "ppx_deriving_variant_string"
  "ppx_enumerate"
  "qcheck-core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jongleb/meltea.git"
