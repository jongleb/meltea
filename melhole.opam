opam-version: "2.0"
synopsis:
  "Templates with holes for Melange: the runtime and the compiler shared by Melact and Meltea"
maintainer: ["Gleb"]
authors: ["Gleb"]
license: "MIT"
homepage: "https://github.com/jongleb/melact"
bug-reports: "https://github.com/jongleb/melact/issues"
depends: [
  "ocaml" {>= "5.3"}
  "dune" {>= "3.16" & >= "3.16"}
  "melange" {>= "5.1"}
  "ppxlib" {>= "0.34"}
  "ppx_deriving_variant_string"
  "ppx_enumerate"
  "qcheck-core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
