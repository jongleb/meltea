open Testing

external input_value : Dom.node -> string = "value" [@@mel.get]
external input_checked : Dom.node -> bool = "checked" [@@mel.get]
external select_all : Dom.element -> string -> Dom.nodeList = "querySelectorAll" [@@mel.send]
external clone : Dom.element -> (_[@mel.as {json|true|json}]) -> Dom.element = "cloneNode" [@@mel.send]
external remove_attribute : Dom.node -> string -> unit = "removeAttribute" [@@mel.send]

type item = { id : int; title : string; finished : bool }

(** Which items the list shows. *)
type filter = All | Active | Completed

type model = { items : item list; draft : string; next : int; filter : filter }

type message =
  | Type of string
  | Add
  | Toggle of int
  | Remove of int
  | Show of filter
  | Same

let init = { items = []; draft = ""; next = 0; filter = All }

let update message model =
  match message with
  | Type draft -> { model with draft }
  | Add -> (
      match model.draft with
      | "" -> model
      | title ->
          {
            model with
            items = model.items @ [ { id = model.next; title; finished = false } ];
            draft = "";
            next = model.next + 1;
          })
  | Toggle id ->
      {
        model with
        items =
          List.map
            (fun item -> if item.id = id then { item with finished = not item.finished } else item)
            model.items;
      }
  | Remove id -> { model with items = List.filter (fun item -> item.id <> id) model.items }
  | Show filter -> { model with filter }
  | Same -> model

let row item =
  <li key=(string_of_int item.id) className=(if item.finished then "done" else "")>
    <input type_="checkbox" checked=item.finished onCheck=(fun _ -> Toggle item.id) />
    <span>(Html.text item.title)</span>
    <button onClick=(Remove item.id)>(Html.text "x")</button>
  </li>

let view model =
  let shown =
    List.filter
      (fun item ->
        match model.filter with
        | All -> true
        | Active -> not item.finished
        | Completed -> item.finished)
      model.items
  in
  <section>
    <input value=model.draft onInput=(fun text -> Type text) />
    <button onClick=Add>(Html.text "add")</button>
    <ul>(Html.list (List.map row shown))</ul>
    <p>(Html.int (List.length (List.filter (fun item -> not item.finished) model.items)))</p>
  </section>

(** One step of a generated run. *)
type step = Send of message | Flush

let steps tape =
  let words = [| ""; "milk"; "tea"; "a&b" |] in
  let rec go model remaining collected =
    if remaining = 0 then List.rev collected
    else
      let ids = List.map (fun item -> item.id) model.items in
      let pick () = List.nth ids (draw tape (List.length ids)) in
      let step =
        match (draw tape 8, ids) with
        | 0, _ -> Send (Type words.(draw tape 4))
        | 1, _ -> Send Add
        | 2, _ :: _ -> Send (Toggle (pick ()))
        | 3, _ :: _ -> Send (Remove (pick ()))
        | 4, _ -> Send (Show [| All; Active; Completed |].(draw tape 3))
        | 5, _ -> Send Same
        | _, _ -> Flush
      in
      let model = match step with Send message -> update message model | Flush -> model in
      go model (remaining - 1) (step :: collected)
  in
  go init (6 + draw tape 30) []

let snapshot root =
  let copy = clone root in
  Array.iter (fun node -> remove_attribute node "checked") (nodes (select_all copy "input"));
  ( shapes (as_node copy),
    Array.to_list
      (Array.map
         (fun node -> (input_value node, input_checked node))
         (nodes (select_all root "input"))) )

let run program steps =
  List.iter
    (fun step -> match step with Send message -> Program.dispatch program message | Flush -> Program.flush program)
    steps;
  Program.flush program

let final steps =
  List.fold_left
    (fun model step -> match step with Send message -> update message model | Flush -> model)
    init steps

let evaluations = ref 0

let counted items =
  incr evaluations;
  List.length items

let guarded_view model =
  let items = model.items in
  <section>
    <p>(Html.int (counted items))</p>
    <i>(Html.text model.draft)</i>
  </section>

(** What a law subscribes to: the hash, tagged, or a timer too slow to fire. *)
type listener = Hash_listener of int | Timer of int

(** A program that only listens. *)
type heard = Set of listener list | Heard of int * string

let go_to : string -> unit =
  [%mel.raw
    {|function (hash) { history.replaceState(null, "", hash); window.dispatchEvent(new Event("hashchange")); }|}]

(** A list whose rows read two values from outside the row. *)
type marked = { rows : item list; chosen : int option; suffix : string }

(** What changes a marked list. *)
type mark = Choose of int option | Suffix of string | Flip of int | Drop of int | Grow

let mark_update message model =
  match message with
  | Choose chosen -> { model with chosen }
  | Suffix suffix -> { model with suffix }
  | Flip id ->
      {
        model with
        rows =
          List.map (fun item -> if item.id = id then { item with finished = not item.finished } else item) model.rows;
      }
  | Drop id -> { model with rows = List.filter (fun item -> item.id <> id) model.rows }
  | Grow ->
      let id = List.length model.rows + 100 in
      { model with rows = model.rows @ [ { id; title = "t" ^ string_of_int id; finished = false } ] }

let mark_view { rows; chosen; suffix } =
  let row item =
    <li
      key=(string_of_int item.id)
      className=(match chosen with Some id when id = item.id -> "on" | Some _ | None -> "")>
      (Html.text (item.title ^ suffix))
    </li>
  in
  <ul>(Html.list (List.map row rows))</ul>

let glide_view { rows; chosen; suffix } =
  let row item =
    <li
      key=(string_of_int item.id)
      className=(match chosen with Some id when id = item.id -> "on" | Some _ | None -> "")>
      (Html.text (item.title ^ suffix))
    </li>
  in
  <ul>(Html.transition_group ~name:"row" ~duration:50 (Html.list (List.map row rows)))</ul>

external use_fake_timers : < toFake : string array > Js.t -> unit = "useFakeTimers" [@@mel.scope "vi"]
external use_real_timers : unit -> unit = "useRealTimers" [@@mel.scope "vi"]
external advance : int -> unit = "advanceTimersByTime" [@@mel.scope "vi"]
external class_name : Dom.node -> string = "className" [@@mel.get]

let mark_init =
  { rows = List.init 6 (fun id -> { id; title = "t" ^ string_of_int id; finished = false }); chosen = None; suffix = "" }

let derived_view count =
  <button className=(match count < 0 with true -> "negative" | false -> "") disabled=(count mod 3 = 0)>
    (Html.text (string_of_int (count / 4)))
  </button>

let scroll_view shown =
  <section>
    (match shown with
    | true -> <div onScroll=(not shown)>(Html.text "scroll me")</div>
    | false -> Html.none)
  </section>

(** What the buttons send, through which tag, and what the test shows next. *)
type picked = Picked of int | Tagged of picked | Display of (int list * bool)

let picker_view (shown, tagged) =
  let buttons = Html.list (List.map (fun value -> <button onClick=(Picked value)><b>(Html.int value)</b></button>) shown) in
  <div>(match tagged with true -> Html.map (fun message -> Tagged message) buttons | false -> buttons)</div>

external as_element : Dom.node -> Dom.element = "%identity"

let scroll_rows_view ids =
  <section>
    (Html.list (List.map (fun id -> <div key=(string_of_int id) onScroll=[ id ]>(Html.int id)</div>) ids))
  </section>

let derived_writes previous next =
  (match (previous < 0, next < 0) with true, true | false, false -> 0 | _ -> 1)
  + (match (previous mod 3 = 0, next mod 3 = 0) with true, true | false, false -> 0 | _ -> 1)
  + match previous / 4 = next / 4 with true -> 0 | false -> 1

(** A model with a field the view shows and one it never reads. *)
type split = { shown : int; hidden : int }

(** What changes a split model. *)
type poke = Show | Hide | Keep

let views = ref 0

let split_update message model =
  let bump count = count + 1 in
  match message with
  | Show -> { model with shown = bump model.shown }
  | Hide -> { model with hidden = bump model.hidden }
  | Keep -> model

let split_view { shown; _ } =
  incr views;
  <p>(Html.int shown)</p>

(** An update analysed and then redefined: its companion describes the first one. *)
module Shadowed = struct
  let update message model = match message with Show | Hide | Keep -> model
  let update message model = split_update message model
  let view { shown; _ } = <p>(Html.int shown)</p>
end

let () =
  describe "Meltea laws" (fun () ->
    test "a companion that describes another function is not used" (fun () ->
      check
        (property (tapes ~shortest:2 ~longest:40) (fun values ->
             let tape = tape values in
             let root = create_element document "div" in
             let program =
               Program.sandbox ~init:{ shown = 0; hidden = 0 } ~update:Shadowed.update ~view:Shadowed.view root
             in
             let shown = ref 0 in
             Array.iter
               (fun _ ->
                 match draw tape 3 with
                 | 0 ->
                     incr shown;
                     Program.dispatch program Show
                 | 1 -> Program.dispatch program Hide
                 | _ -> Program.flush program)
               values;
             Program.flush program;
             let text = text_content root in
             Program.stop program;
             expect text |. to_be (string_of_int !shown)))
        [%mel.obj { numRuns = 200 }]);
    test "the view runs exactly when a message changed a field it reads" (fun () ->
      check
        (property (tapes ~shortest:4 ~longest:60) (fun values ->
             let tape = tape values in
             views := 0;
             let root = create_element document "div" in
             let program =
               Program.sandbox ~init:{ shown = 0; hidden = 0 } ~update:split_update ~view:split_view root
             in
             let expected = ref 1 and touched = ref false and model = ref { shown = 0; hidden = 0 } in
             Array.iter
               (fun _ ->
                 match draw tape 4 with
                 | 0 ->
                     Program.flush program;
                     if !touched then incr expected;
                     touched := false
                 | choice ->
                     let message = [| Show; Hide; Keep |].(choice - 1) in
                     model := split_update message !model;
                     (match message with Show -> touched := true | Hide | Keep -> ());
                     Program.dispatch program message)
               values;
             Program.flush program;
             if !touched then incr expected;
             let shown = text_content root in
             Program.stop program;
             expect (!views, shown) |. to_equal (!expected, string_of_int !model.shown)))
        [%mel.obj { numRuns = 300 }]);
    test "rows that read outer values change exactly when those values change for them" (fun () ->
      check
        (property (tapes ~shortest:4 ~longest:60) (fun values ->
             let tape = tape values in
             let root = create_element document "div" and fresh = create_element document "div" in
             let program = Program.sandbox ~init:mark_init ~update:mark_update ~view:mark_view root in
             let model = ref mark_init in
             List.iter
               (fun _ ->
                 let ids = List.map (fun item -> item.id) !model.rows in
                 let pick () = List.nth_opt ids (draw tape (max 1 (List.length ids))) in
                 let message =
                   match draw tape 5 with
                   | 0 -> Choose (match draw tape 3 with 0 -> None | _ -> pick ())
                   | 1 -> Suffix [| ""; "!"; "?" |].(draw tape 3)
                   | 2 -> Option.fold ~none:Grow ~some:(fun id -> Flip id) (pick ())
                   | 3 -> Option.fold ~none:Grow ~some:(fun id -> Drop id) (pick ())
                   | _ -> Grow
                 in
                 model := mark_update message !model;
                 Program.dispatch program message;
                 if draw tape 2 = 0 then Program.flush program)
               (List.init (Array.length values / 3) Fun.id);
             Program.flush program;
             let expected = Program.sandbox ~init:!model ~update:mark_update ~view:mark_view fresh in
             expect (shapes (as_node root)) |. to_equal (shapes (as_node fresh));
             Program.stop program;
             Program.stop expected))
        [%mel.obj { numRuns = 300 }]);
    test "a list in Html.transition_group keeps a dropped row while it leaves, then shows the model" (fun () ->
      check
        (property (tapes ~shortest:4 ~longest:60) (fun values ->
             use_fake_timers [%mel.obj { toFake = [| "setTimeout"; "requestAnimationFrame"; "Date" |] }];
             let tape = tape values in
             let root = create_element document "div" and fresh = create_element document "div" in
             let program = Program.sandbox ~init:mark_init ~update:mark_update ~view:glide_view root in
             let model = ref mark_init in
             let leaving = ref 0 and dropped = ref 0 in
             List.iter
               (fun _ ->
                 let ids = List.map (fun item -> item.id) !model.rows in
                 let pick () = List.nth_opt ids (draw tape (max 1 (List.length ids))) in
                 let message =
                   match draw tape 4 with
                   | 0 -> Choose (pick ())
                   | 1 -> Suffix [| ""; "!" |].(draw tape 2)
                   | 2 -> Option.fold ~none:Grow ~some:(fun id -> Drop id) (pick ())
                   | _ -> Grow
                 in
                 let previous = !model.rows in
                 model := mark_update message !model;
                 Program.dispatch program message;
                 Program.flush program;
                 (match message with
                 | Drop id ->
                     dropped := !dropped + List.length (List.filter (fun item -> item.id = id) previous);
                     leaving :=
                       !leaving
                       + Array.length
                           (Js.Array.filter
                              ~f:(fun node -> Js.String.includes ~search:"row-leave" (class_name node))
                              (nodes (select_all root "li")))
                 | Choose _ | Suffix _ | Flip _ | Grow -> ());
                 advance 100)
               (List.init (Array.length values / 3) Fun.id);
             let expected = Program.sandbox ~init:!model ~update:mark_update ~view:glide_view fresh in
             Program.flush expected;
             let seen = (shapes (as_node root), !leaving) and wanted = (shapes (as_node fresh), !dropped) in
             Program.stop program;
             Program.stop expected;
             use_real_timers ();
             expect seen |. to_equal wanted))
        [%mel.obj { numRuns = 200 }]);
    test "a hole is written exactly when its value changes, and an attribute that becomes None goes" (fun () ->
      check
        (property (tapes ~shortest:4 ~longest:40) (fun values ->
             let tape = tape values in
             let root = create_element document "div" and fresh = create_element document "div" in
             let program = Program.sandbox ~init:0 ~update:(fun next _ -> next) ~view:derived_view root in
             let watcher = observer (fun () -> ()) in
             observe watcher root [%mel.obj { childList = true; subtree = true; attributes = true; characterData = true }];
             let count = ref 0 in
             let seen =
               List.map
                 (fun _ ->
                   let next = draw tape 13 - 6 in
                   let expected = derived_writes !count next in
                   count := next;
                   Program.dispatch program next;
                   Program.flush program;
                   (Array.length (take_records watcher), expected))
                 (List.init (Array.length values) Fun.id)
             in
             disconnect watcher;
             let expected_page = Program.sandbox ~init:!count ~update:(fun next _ -> next) ~view:derived_view fresh in
             let shown = (shapes (as_node root), shapes (as_node fresh)) in
             Program.stop program;
             Program.stop expected_page;
             expect (List.map fst seen, fst shown) |. to_equal (List.map snd seen, snd shown)))
        [%mel.obj { numRuns = 200 }]);
    test "an element's own listener for a non-bubbling event goes with the element" (fun () ->
      check
        (property (tapes ~shortest:2 ~longest:20) (fun values ->
             let tape = tape values in
             let adds = spy_on event_target_prototype "addEventListener" in
             let removes = spy_on event_target_prototype "removeEventListener" in
             let root = create_element document "div" in
             let program = Program.sandbox ~init:true ~update:(fun next _ -> next) ~view:scroll_view root in
             Array.iter
               (fun _ ->
                 Program.dispatch program (draw tape 2 = 0);
                 Program.flush program)
               values;
             Program.stop program;
             let scrolls spy =
               List.length
                 (List.filter (fun call -> String.equal call.(0) "scroll") (Array.to_list (calls (mock spy))))
             in
             let left = scrolls adds - scrolls removes and added = scrolls adds in
             restore adds;
             restore removes;
             expect (left, added > 0) |. to_equal (0, true)))
        [%mel.obj { numRuns = 100 }]);
    test "a click sends the message of what the clicked element shows now, through the current dispatch" (fun () ->
      check
        (property (tapes ~shortest:4 ~longest:40) (fun values ->
             let tape = tape values in
             let sent = ref [] and expected = ref [] in
             let root = attached () in
             let model = ref ([ 1; 2; 3 ], false) in
             let program =
               Program.sandbox ~init:!model
                 ~update:(fun message state ->
                   match message with
                   | Display (shown, tagged) -> (shown, tagged)
                   | Picked _ | Tagged _ ->
                       sent := message :: !sent;
                       state)
                 ~view:picker_view root
             in
             Array.iter
               (fun _ ->
                 match draw tape 3 with
                 | 0 ->
                     let next = (List.init (1 + draw tape 4) (fun _ -> draw tape 9), draw tape 2 = 0) in
                     model := next;
                     Program.dispatch program (Display next);
                     Program.flush program
                 | _ ->
                     let shown, tagged = !model in
                     let at = draw tape (List.length shown) in
                     click (as_element (nodes (select_all root "b")).(at));
                     let message = Picked (List.nth shown at) in
                     expected := (match tagged with true -> Tagged message | false -> message) :: !expected)
               values;
             Program.stop program;
             expect (List.rev !sent) |. to_equal (List.rev !expected)))
        [%mel.obj { numRuns = 150 }]);
    test "a compiled list holds exactly one listener of its own per row, and none once it stops" (fun () ->
      check
        (property (tapes ~shortest:4 ~longest:40) (fun values ->
             let tape = tape values in
             let adds = spy_on event_target_prototype "addEventListener" in
             let removes = spy_on event_target_prototype "removeEventListener" in
             let scrolls spy =
               List.length
                 (List.filter (fun call -> String.equal call.(0) "scroll") (Array.to_list (calls (mock spy))))
             in
             let root = create_element document "div" in
             let program = Program.sandbox ~init:[] ~update:(fun next _ -> next) ~view:scroll_rows_view root in
             let seen =
               List.map
                 (fun _ ->
                   let ids = List.filter (fun _ -> draw tape 3 > 0) [ 0; 1; 2; 3; 4; 5 ] in
                   let ids = match draw tape 2 with 0 -> ids | _ -> List.rev ids in
                   Program.dispatch program ids;
                   Program.flush program;
                   (scrolls adds - scrolls removes, List.length ids))
                 (List.init (Array.length values / 2) Fun.id)
             in
             Program.stop program;
             let left = scrolls adds - scrolls removes in
             restore adds;
             restore removes;
             expect (List.map fst seen, left) |. to_equal (List.map snd seen, 0)))
        [%mel.obj { numRuns = 150 }]);
    test "after any change of subscriptions, a hash change sends exactly the current ones' messages"
      (fun () ->
        check
          (property (tapes ~shortest:4 ~longest:60) (fun values ->
               let tape = tape values in
               let heard = ref [] in
               let program =
                 Program.element ~init:([], Cmd.none)
                   ~update:(fun message listeners ->
                     match message with
                     | Set listeners -> (listeners, Cmd.none)
                     | Heard (tag, hash) ->
                         heard := (tag, hash) :: !heard;
                         (listeners, Cmd.none))
                   ~view:(fun _ -> Html.none)
                   ~subscriptions:(fun listeners ->
                     Sub.batch
                       (List.map
                          (fun listener ->
                            match listener with
                            | Hash_listener tag -> Sub.hash (fun hash -> Heard (tag, hash))
                            | Timer interval -> Sub.every (100000 + interval) (fun _ -> Heard (-1, "")))
                          listeners))
                   (create_element document "div")
               in
               let rounds =
                 List.init (1 + draw tape 6) (fun round ->
                     let listeners =
                       List.init (draw tape 5) (fun _ ->
                           match draw tape 3 with
                           | 0 -> Timer (draw tape 2)
                           | _ -> Hash_listener (draw tape 4))
                     in
                     Program.dispatch program (Set listeners);
                     Program.flush program;
                     heard := [];
                     let hash = "#/" ^ string_of_int round in
                     go_to hash;
                     ( List.sort compare !heard,
                       List.sort compare
                         (List.filter_map
                            (fun listener ->
                              match listener with
                              | Hash_listener tag -> Some (tag, hash)
                              | Timer _ -> None)
                            listeners) ))
               in
               Program.flush program;
               Program.stop program;
               heard := [];
               go_to "#/stopped";
               expect (List.map fst rounds, !heard) |. to_equal (List.map snd rounds, [])))
          [%mel.obj { numRuns = 300 }]);
    test "a hole is evaluated once on mount and again exactly when a local it reads changes" (fun () ->
      check
        (property (tapes ~shortest:20 ~longest:120) (fun values ->
           evaluations := 0;
           let steps = steps (tape values) in
           let root = create_element document "div" in
           let program = Program.sandbox ~init ~update ~view:guarded_view root in
           let expected = ref 1 and drawn = ref init and model = ref init in
           List.iter
             (fun step ->
               match step with
               | Send message -> model := update message !model
               | Flush ->
                   if not (!model.items == !drawn.items) then incr expected;
                   drawn := !model)
             (steps @ [ Flush ]);
           run program steps;
           Program.stop program;
           expect !evaluations |. to_be !expected))
        [%mel.obj { numRuns = 300 }]);
    test "after any messages, the DOM is the view of fold update init messages" (fun () ->
      check
        (property (tapes ~shortest:20 ~longest:120) (fun values ->
           let steps = steps (tape values) in
           let root = create_element document "div" and fresh = create_element document "div" in
           let program = Program.sandbox ~init ~update ~view root in
           run program steps;
           let expected = Program.sandbox ~init:(final steps) ~update ~view fresh in
           expect (snapshot root) |. to_equal (snapshot fresh);
           Program.stop program;
           Program.stop expected))
        [%mel.obj { numRuns = 300 }]);
    test "a message that keeps the model, and a flush with nothing pending, write nothing" (fun () ->
      check
        (property (tapes ~shortest:20 ~longest:120) (fun values ->
           let root = create_element document "div" in
           let program = Program.sandbox ~init ~update ~view root in
           run program (steps (tape values));
           let watcher = observer (fun () -> ()) in
           observe watcher root
             [%mel.obj { childList = true; subtree = true; attributes = true; characterData = true }];
           Program.flush program;
           Program.dispatch program Same;
           Program.flush program;
           let records = Array.length (take_records watcher) in
           disconnect watcher;
           Program.stop program;
           expect records |. to_be 0))
        [%mel.obj { numRuns = 300 }]);
    test "Html.memo calls the view exactly when the model changes physically" (fun () ->
      check
        (property (tapes ~shortest:20 ~longest:120) (fun values ->
           let calls = ref 0 in
           let counted model =
             incr calls;
             view model
           in
           let steps = steps (tape values) in
           let root = create_element document "div" in
           let program =
             Program.sandbox ~init ~update ~view:(fun model -> Html.memo counted model) root
           in
           let renders = ref 1 and last = ref init and model = ref init in
           List.iter
             (fun step ->
               match step with
               | Send message -> model := update message !model
               | Flush ->
                   if not (!model == !last) then incr renders;
                   last := !model)
             (steps @ [ Flush ]);
           run program steps;
           Program.stop program;
           expect !calls |. to_be !renders))
        [%mel.obj { numRuns = 300 }]);
    test "Html.map tags every message sent from inside" (fun () ->
      check
        (property (tapes ~shortest:4 ~longest:20) (fun values ->
           let tape = tape values in
           let id = draw tape 100 in
           let seen = ref [] in
           let root = attached () in
           let item = { id; title = "t"; finished = false } in
           let program =
             Program.sandbox ~init:() ~update:(fun message () -> seen := message :: !seen)
               ~view:(fun () -> Html.map (fun message -> (id, message)) (row item))
               root
           in
           click (select root "button");
           Program.stop program;
           expect !seen |. to_equal [ (id, Remove id) ]))
        [%mel.obj { numRuns = 100 }]))

(** What the paced counter has seen. *)
type paced = { moves : int; clicks : int }

(** A message of the paced counter. *)
type pacing = Moved | Clicked

(** One step of a paced run. *)
type pace_step = Move | Click | Tick | Frame

external test_async : string -> (unit -> unit Js.Promise.t) -> unit = "test"
external remove_root : Dom.element -> unit = "remove" [@@mel.send]

let stub_frames : unit -> unit =
  [%mel.raw {|function () { globalThis.__frames = []; globalThis.requestAnimationFrame = function (f) { globalThis.__frames.push(f); return 0; }; }|}]

let run_frames : unit -> unit =
  [%mel.raw {|function () { var due = globalThis.__frames; globalThis.__frames = []; due.forEach(function (f) { f(0); }); }|}]

let tick : unit -> unit Js.Promise.t = [%mel.raw {|function () { return new Promise(function (done) { setTimeout(done, 0); }); }|}]
external pointer : string -> < bubbles : bool > Js.t -> Dom.event = "Event" [@@mel.new]
external dispatch_on : Dom.element -> Dom.event -> unit = "dispatchEvent" [@@mel.send]

let ( let* ) promise next = Js.Promise.then_ next promise

let () =
  describe "Meltea pacing" (fun () ->
    test_async "pointer moves draw once a frame, a click draws at the next microtask, and the page is the view of what was drawn" (fun () ->
      stub_frames ();
      check_async
        (async_property (tapes ~shortest:4 ~longest:40) (fun values ->
           let tape = tape values in
           let steps = List.init (4 + draw tape 20) (fun _ -> [| Move; Move; Click; Tick; Frame |].(draw tape 5)) in
           let calls = ref 0 in
           let view model =
             incr calls;
             <div className="area" onPointerMove=Moved>
               (Html.int model.moves)(Html.text "/")(Html.int model.clicks)
               <button onClick=Clicked>(Html.text "c")</button>
             </div>
           in
           let update message model =
             match message with Moved -> { model with moves = model.moves + 1 } | Clicked -> { model with clicks = model.clicks + 1 }
           in
           let root = attached () in
           let program = Program.sandbox ~init:{ moves = 0; clicks = 0 } ~update ~view root in
           let area = select root ".area" in
           let shown () = text_content area in
           let rec go remaining current drawn schedule draws agreed =
             let text model = string_of_int model.moves ^ "/" ^ string_of_int model.clicks ^ "c" in
             match remaining with
             | [] -> Js.Promise.resolve (draws, agreed, !calls)
             | step :: rest -> (
                 match step with
                 | Move ->
                     dispatch_on area (pointer "pointermove" [%mel.obj { bubbles = true }]);
                     let current = update Moved current in
                     go rest current drawn (match schedule with `Idle -> `Framed | other -> other) draws agreed
                 | Click ->
                     click (select root "button");
                     go rest (update Clicked current) drawn `Queued draws agreed
                 | Tick ->
                     let* () = tick () in
                     let drawn, schedule, draws =
                       match schedule with `Queued -> (current, `Idle, draws + 1) | (`Idle | `Framed) as other -> (drawn, other, draws)
                     in
                     go rest current drawn schedule draws (agreed && String.equal (shown ()) (text drawn))
                 | Frame ->
                     let* () = tick () in
                     run_frames ();
                     let drawn, schedule, draws =
                       match schedule with `Framed | `Queued -> (current, `Idle, draws + 1) | `Idle -> (drawn, `Idle, draws)
                     in
                     go rest current drawn schedule draws (agreed && String.equal (shown ()) (text drawn)))
           in
           let* draws, agreed, made = go steps { moves = 0; clicks = 0 } { moves = 0; clicks = 0 } `Idle 1 true in
           let* () = tick () in
           run_frames ();
           Program.stop program;
           remove_root root;
           expect (made, agreed) |. to_equal (draws, true);
           Js.Promise.resolve ()))
        [%mel.obj { numRuns = 100 }]))
